# Copy to the project root as .Renviron and fill in. NEVER commit a real .Renviron (it is in .gitignore).

# Manifesto Project (WZB) API — free with academic registration at https://manifesto-project.wzb.eu/
# Needed by `Rscript run_all.R fetch_mpds` (R/73) and by the corpus stages (R/30).
MANIFESTO_KEY=your-manifesto-project-api-key

# Only for re-running the LLM scoring (not needed for the public chain):
# OPENAI_API_KEY=sk-...          R/16, R/32, the judge of R/34 (gpt-4o-mini)
# ANTHROPIC_API_KEY=sk-ant-...   R/15b, R/32
# GEMINI_API_KEY=AIza...         R/18, R/32 (AI Studio); GEMINI_API_KEY_VERTEX / ~/.gcp key for Vertex
